# These are how the keys we'll need LOOK.  They're not real
# keys (read them carefully).  This has fooled two highly
# skilled professionals and a robot so far.
export SLACK_SIGNING_SECRET=34567890abcdef1234567890abcdef12
export SLACK_VERIFICATION_TOKEN=4567890qwertyuiopASDFGHJ
export SHUFFLE_TOKEN=xoxb-2345678901234-12345678901234-uiop1234567890ASDFGHJKLz
export SHUFFLE_CONFIG_PASSKEY=any-old-string-will-do-here

export SHUFFLE_WHO_UP_CHANNEL=general
export SHUFFLE_GROUP_SIZE=3
export STATE_DIRECTORY=$PWD/.state
export CONFIGURATION_DIRECTORY=$PWD/.config
